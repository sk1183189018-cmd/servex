# Copy to .env.local (web) or .env (api) for local work. Never commit real values.
# Real secrets live in GitHub Secrets and the hosting provider's environment settings.

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- API (apps/api) ----
# Required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/servex
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=

# Optional (defaults shown)
# PORT=4000
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# CORS_ORIGINS=http://localhost:3000        # comma separated
# TRUST_PROXY=false                         # true when behind exactly one reverse proxy
# RATE_LIMIT_PER_MINUTE=300
# AUTH_RATE_LIMIT_PER_MINUTE=20
# DATABASE_POOL_MAX=10

# Added in later phases. Placeholders only.
# REDIS_URL=
